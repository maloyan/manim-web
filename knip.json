{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "project": ["src/**/*.ts", "src/**/*.tsx", "examples/playground/**/*.ts"],
  "entry": ["examples/playground/playground.ts"],
  "ignore": ["src/core/SceneExtensions.ts"],
  "ignoreDependencies": ["@types/katex", "typedoc", "vue"],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "rules": {
    "optionalPeerDependencies": "off",
    "duplicates": "off",
    "types": "off"
  }
}
