{
  "name": "manim-web",
  "version": "0.39.4",
  "description": "Manim-like mathematical animation library for the web",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/integrations/react.d.ts",
      "import": "./dist/integrations/react.js",
      "default": "./dist/integrations/react.js"
    },
    "./vue": {
      "types": "./dist/integrations/vue.d.ts",
      "import": "./dist/integrations/vue.js",
      "default": "./dist/integrations/vue.js"
    },
    "./element": {
      "types": "./dist/integrations/webcomponent.d.ts",
      "import": "./dist/integrations/webcomponent.js",
      "default": "./dist/integrations/webcomponent.js"
    },
    "./notebook": {
      "types": "./dist/integrations/notebook.d.ts",
      "import": "./dist/integrations/notebook.js",
      "default": "./dist/integrations/notebook.js"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "import": "./dist/manim-web.browser.js",
      "default": "./dist/manim-web.browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && vite build --config vite.browser.config.ts",
    "build:browser": "vite build --config vite.browser.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "lint:no-disable": "bash scripts/check-no-eslint-disable.sh",
    "format": "prettier --write src/",
    "docs": "npm run build && node scripts/generate-example-docs.mjs && cd docs && npm run build",
    "docs:dev": "npm run build && node scripts/generate-example-docs.mjs && cd docs && npm start",
    "docs:examples": "node scripts/generate-example-docs.mjs",
    "lint:strict": "eslint src/ --max-warnings 106",
    "circular": "madge --circular --extensions ts src/",
    "cpd": "jscpd src/",
    "test:integration": "npx playwright test",
    "format:check": "prettier --check src/",
    "knip": "knip",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@mathjax/src": "^4.1.1",
    "@types/opentype.js": "^1.3.10",
    "@types/three": "^0.186.0",
    "earcut": "^3.0.2",
    "gif.js": "^0.2.0",
    "gifuct-js": "^2.1.2",
    "jspdf": "^4.2.1",
    "katex": "^0.19.0",
    "lottie-web": "^5.12.2",
    "mp4-muxer": "^5.2.2",
    "opentype.js": "^2.0.0",
    "polygon-clipping": "^0.15.7",
    "three": "^0.186.1",
    "typia": "^12.1.1",
    "webm-muxer": "^5.1.4"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^9.39.2",
    "@myriaddreamin/typst-ts-renderer": "0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "0.7.0",
    "@myriaddreamin/typst.ts": "0.7.0",
    "@playwright/test": "^1.58.2",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.2.13",
    "@typia/unplugin": "^12.1.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.1.5",
    "codemirror": "^6.0.2",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "happy-dom": "^20.6.1",
    "husky": "^9.1.7",
    "jscpd": "^5.0.9",
    "knip": "^6.1.0",
    "lint-staged": "^17.0.4",
    "lz-string": "^1.5.0",
    "madge": "^8.0.0",
    "prettier": "^3.8.1",
    "standard-version": "^9.5.0",
    "sucrase": "^3.35.1",
    "typedoc": "^0.28.16",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.54.0",
    "vite": "^8.0.8",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^4.0.18",
    "vue": "^3.0.0"
  },
  "peerDependencies": {
    "@myriaddreamin/typst-ts-renderer": "0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "0.7.0",
    "@myriaddreamin/typst.ts": "0.7.0",
    "react": ">=18.0.0",
    "vue": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@myriaddreamin/typst-ts-renderer": {
      "optional": true
    },
    "@myriaddreamin/typst-ts-web-compiler": {
      "optional": true
    },
    "@myriaddreamin/typst.ts": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maloyan/manim-web.git"
  },
  "homepage": "https://maloyan.github.io/manim-web/",
  "bugs": {
    "url": "https://github.com/maloyan/manim-web/issues"
  },
  "keywords": [
    "animation",
    "math",
    "visualization",
    "manim",
    "threejs",
    "webgl",
    "3blue1brown",
    "mathematical-animations",
    "typescript"
  ],
  "license": "MIT"
}
